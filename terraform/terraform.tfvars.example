# Copy to terraform.tfvars (gitignored) and adjust for your account.
# Every value below is also a working default in variables.tf — you only
# need this file to override something.

project_name = "weather-ai"
environment  = "dev"
aws_region   = "us-east-1"

vpc_cidr              = "10.20.0.0/16"
availability_zones    = ["us-east-1a", "us-east-1b"]
private_subnet_cidrs  = ["10.20.1.0/24", "10.20.2.0/24"]

# Interface VPC endpoints cost ~$0.01/hr each + data processing. Set false
# for a $0 dry run of the network topology; the DynamoDB gateway endpoint
# is always free and always created regardless of this flag.
enable_interface_endpoints = true

# Independent of the flag above: just the CloudWatch Logs endpoint, needed
# only if some future function in this VPC is VPC-attached and needs log
# visibility without paying for the other three interface endpoints. The
# current weather-ai-api Lambda is NOT VPC-attached (see lambda.tf), so it
# reaches CloudWatch Logs over the public endpoint directly and doesn't
# need this. ~$7/mo alone if turned on.
enable_lambda_logs_endpoint = false

lambda_function_name = "weather-ai-api"
dynamodb_table_name  = "weather-ai-cache"
bedrock_model_id     = "us.anthropic.claude-haiku-4-5-20251001-v1:0"
bedrock_foundation_model_id         = "anthropic.claude-haiku-4-5-20251001-v1:0"
bedrock_profile_destination_regions = ["us-east-1", "us-east-2", "us-west-1", "us-west-2"]
secrets_name_prefix  = "weather-ai/"

kms_key_deletion_window_days = 7
