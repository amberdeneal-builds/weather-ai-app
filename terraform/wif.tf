# Workload Identity Federation - replaces the long-lived GCP service-account
# key that weather-ai-api has been using for its Vertex AI failover.
#
# Before: a service-account JSON key, generated by hand, stored in Secrets
# Manager, read by the Lambda at failover time. It never expires on its own,
# and anything able to read that secret can reach the GCP project.
#
# After: the Lambda's own AWS execution role IS the identity. google-auth
# signs an AWS STS GetCallerIdentity request, GCP verifies it against this
# pool, and returns a short-lived access token. No key exists anywhere.
#
# Why this works on Lambda specifically: google-auth checks the AWS_* env
# vars Lambda already sets before it tries the EC2 metadata service, which
# Lambda does not have. Verified against google-auth 2.35.0 - see
# google/auth/aws.py, get_aws_security_credentials() and get_aws_region().

data "google_project" "this" {
  project_id = var.gcp_project_id
}

resource "google_iam_workload_identity_pool" "aws" {
  project                   = var.gcp_project_id
  workload_identity_pool_id = var.gcp_wif_pool_id
  display_name              = "Weather AI AWS"
  description               = "Trusts AWS IAM roles from the weather-ai account so they can call Vertex AI without a service-account key."
}

resource "google_iam_workload_identity_pool_provider" "aws_lambda" {
  project                            = var.gcp_project_id
  workload_identity_pool_id          = google_iam_workload_identity_pool.aws.workload_identity_pool_id
  workload_identity_pool_provider_id = var.gcp_wif_provider_id
  display_name                       = "AWS Lambda"
  description                        = "weather-ai-api's Lambda execution role."

  # google.subject is what lands in GCP audit logs, so it carries the full
  # assumed-role ARN rather than something summarised.
  attribute_mapping = {
    "google.subject"        = "assertion.arn"
    "attribute.aws_account" = "assertion.account"
    "attribute.aws_role"    = "assertion.arn.extract('assumed-role/{role}/')"
  }

  # aws.account_id below already limits this to one AWS account; this narrows
  # it to the single execution role, so no other role in the account can mint
  # a Vertex token even by accident.
  attribute_condition = "attribute.aws_account == \"${data.aws_caller_identity.current.account_id}\" && attribute.aws_role == \"${aws_iam_role.lambda_exec.name}\""

  aws {
    account_id = data.aws_caller_identity.current.account_id
  }
}

# The narrowest grant that makes the failover work: aiplatform.user, scoped to
# the one AWS role rather than the whole pool. Granted directly to the
# federated principal - there is deliberately no service account left in the
# middle to impersonate.
resource "google_project_iam_member" "vertex_user" {
  project = var.gcp_project_id
  role    = "roles/aiplatform.user"
  member  = "principalSet://iam.googleapis.com/projects/${data.google_project.this.number}/locations/global/workloadIdentityPools/${google_iam_workload_identity_pool.aws.workload_identity_pool_id}/attribute.aws_role/${aws_iam_role.lambda_exec.name}"
}

output "gcp_wif_audience" {
  description = "The external-account audience the Lambda presents to GCP STS. Handy for reproducing a token exchange by hand when debugging."
  value       = "//iam.googleapis.com/projects/${data.google_project.this.number}/locations/global/workloadIdentityPools/${google_iam_workload_identity_pool.aws.workload_identity_pool_id}/providers/${google_iam_workload_identity_pool_provider.aws_lambda.workload_identity_pool_provider_id}"
}
