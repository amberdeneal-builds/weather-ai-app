# commit terraform.tfvars.example instead and keep this local.
terraform.tfvars
*.auto.tfvars
*.auto.tfvars.json
.terraform.lock.hcl.bak

# --- AWS / secrets ---
.env
.env.*
*.pem
*.key
credentials
.aws/

